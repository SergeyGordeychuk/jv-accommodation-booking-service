# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/booking_service?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-minimum-256-bits-long
JWT_EXPIRATION=3600000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_SUCCESS_URL=http://localhost:8080/api/payments/success
STRIPE_CANCEL_URL=http://localhost:8080/api/payments/cancel

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_CHAT_ID=your_chat_id_for_notifications
